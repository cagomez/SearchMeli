# Configuración de Supabase (Obligatorio para guardar usuarios y búsquedas)
# Obtén estos valores en tu proyecto de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key

# Google Gemini API Key (Recomendado para análisis de imagen con IA)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu-gemini-api-key
