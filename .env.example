# Supabase (Obligatorio para frontend)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Supabase Secret Key (Solo backend / Vercel para panel de administración)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Mercado Libre App Credentials (Para generar tokens OAuth automáticos)
MELI_CLIENT_ID=tu-app-id
MELI_CLIENT_SECRET=tu-client-secret

# Google Gemini API Key (Opcional como valor por defecto del sistema)
# Nota: Cada usuario también puede configurar su propia clave personal directamente desde la interfaz.
GEMINI_API_KEY=
